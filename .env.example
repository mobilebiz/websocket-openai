# --- サーバー ---
# 自分自身のホスト名。ngrok / Fly.io / VCR で払い出されるもの (https:// は不要)
SERVER_URL=xxxxxxxx

# --- 役割 ---
# full (既定): Fly.io に置く本体。NCCO の返却と音声の WebSocket 中継を行う
# front      : VCR に置く前段。NCCO を返すだけ (vcr.yml で指定するのでここでは不要)
# APP_ROLE=full
#
# WebSocket の接続先ホスト。未指定なら SERVER_URL と同じ (単体構成)
# MEDIA_STREAM_HOST=websocket-openai.fly.dev
#
# scripts/change-url.js が answer_url に設定するホスト。
# 前段 (VCR) を使う場合のみ、そのホスト名を指定する
# ANSWER_URL_HOST=neru-xxxxxxxx-websocket-openai-dev.apse1.runtime.vonage.cloud

# --- OpenAI Realtime API ---
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_MODEL=gpt-realtime
# 省略可。既定値は以下のとおり
# OPENAI_VOICE=alloy
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# --- Vonage ---
# VONAGE_APPLICATION_ID は /connect を呼ぶときの X-API-Key としても使用します
VONAGE_APPLICATION_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VONAGE_PRIVATE_KEY_PATH=./private.key
VONAGE_OUTBOUND_FROM=+8150XXXXXXXX
VONAGE_TRANSPORT_NUMBER=+8190XXXXXXXX
# scripts/change-url.js で Webhook URL を書き換えるときに使用
VONAGE_API_KEY=XXXXXXXXXX
VONAGE_API_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Function Calling ---
OPEN_WEATHER_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
