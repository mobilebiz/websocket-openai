# --- サーバー ---
# ngrok / Fly.io で払い出されるホスト名 (https:// は不要)
SERVER_URL=xxxxxxxx

# --- OpenAI Realtime API ---
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_MODEL=gpt-realtime
# 省略可。既定値は以下のとおり
# OPENAI_VOICE=alloy
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# --- Vonage ---
VONAGE_APPLICATION_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VONAGE_PRIVATE_KEY_PATH=./private.key
VONAGE_OUTBOUND_FROM=+8150XXXXXXXX
VONAGE_TRANSPORT_NUMBER=+8190XXXXXXXX
# scripts/change-url.js で Webhook URL を書き換えるときに使用
VONAGE_API_KEY=XXXXXXXXXX
VONAGE_API_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- /connect の認証 ---
# 未設定の場合は VONAGE_APPLICATION_ID にフォールバックするが、
# アプリケーション ID は秘密情報ではないため専用の値を設定することを推奨
CONNECT_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Function Calling ---
OPEN_WEATHER_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
